# ─────────────────────────────────────────────────────────────
# Review Chat — required environment variables
# Copy this file to .env.local, fill in the values, then add them
# to Vercel (Project → Settings → Environment Variables → Production).
# .env.local is gitignored, so real secrets never get committed.
# ─────────────────────────────────────────────────────────────

# Anthropic API key that powers the chat (Opus 4.8).
# Get it at: https://console.anthropic.com/  → API Keys
# NOTE: every chat message is billed to this key.
ANTHROPIC_API_KEY=

# Shared passcode reviewers type to unlock the Review Chat tab.
# Pick anything; share it only with people allowed to use the chat.
REVIEW_PASSCODE=

# GitHub token used to commit feedback notes to /feedback in the repo.
# Create a FINE-GRAINED token at:
#   github.com → Settings → Developer settings → Fine-grained tokens
#   Repository access: ONLY thirdeyes/springfield-dental-tracker
#   Permission: Contents → Read and write
GITHUB_TOKEN=

# Optional — only set if notes should go somewhere other than the defaults.
# GITHUB_REPO=thirdeyes/springfield-dental-tracker
# GITHUB_BRANCH=main
